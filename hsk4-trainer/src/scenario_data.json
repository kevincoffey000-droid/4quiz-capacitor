  "scenarios": [
    {
      "id": "restaurant_wrong_order",
      "label": "Wrong order at a restaurant",
      "context_slots": [
        {
          "name": "place",
          "tag": "PLACE"
        },
        {
          "name": "person",
          "tag": "PERSON_SERVICE",
          "default": "the waiter"
        }
      ],
      "rounds": [
        {
          "round": 1,
          "fresh_slots": [
            {
              "name": "ordered_item",
              "tag": "THING_FOOD"
            }
          ],
          "template": "You are at {place}. You want to order {ordered_item}.",
          "response_type": "state_goal"
        },
        {
          "round": 2,
          "fresh_slots": [
            {
              "name": "wrong_item",
              "tag": "THING_FOOD"
            }
          ],
          "template": "{person} brings you {wrong_item} instead of {ordered_item}.",
          "response_type": "point_out_problem"
        },
        {
          "round": 3,
          "fresh_slots": [
            {
              "name": "excuse",
              "tag": "EXCUSE"
            }
          ],
          "template": "You point out the mistake. {person} says: \"{excuse}\"",
          "response_type": "respond_to_excuse"
        },
        {
          "round": 4,
          "fresh_slots": [
            {
              "name": "fix_action",
              "tag": "ACTION"
            }
          ],
          "template": "You ask {person} to {fix_action}.",
          "response_type": "make_request"
        },
        {
          "round": 5,
          "fresh_slots": [
            {
              "name": "outcome",
              "tag": "OUTCOME"
            }
          ],
          "template": "{person} {outcome}.",
          "response_type": "react_to_outcome"
        }
      ]
    },
