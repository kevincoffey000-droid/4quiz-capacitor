{
  "_comment": "Reference data model for combinatorial scenario prompts. Three parts: tag taxonomy, a lexicon example (one language), and scenario definitions (language-agnostic).",
  "tag_taxonomy": {
    "_comment": "Narrative tags fill scenario slots. Lesson tags are broad categories used to tag whatever word list a user is currently studying (e.g. HSK1), so it can be sampled for the 'suggested words' panel and, where it plausibly fits, swapped directly into the generated scenario text. THING is split into THING_FOOD / THING_PERSONAL because a random noun can plausibly be a personal object (lost item) or a menu item, but not both -- 'kitchen' is not food, and 'umbrella' is not food either, so lumping them together produced nonsense like 'you order a kitchen'. Likewise a landmark ('near the bakery') is a fixed place, not a losable personal item, so LANDMARK is separate from THING_PERSONAL. PERSON is split into PERSON_SERVICE and PERSON_PUBLIC so a waiter can't get picked to give someone directions on the street.",
    "narrative_tags": [
      "PLACE",
      "PLACE_DESTINATION",
      "THING_FOOD",
      "THING_PERSONAL",
      "LANDMARK",
      "PERSON_SERVICE",
      "PERSON_PUBLIC",
      "EXCUSE",
      "ACTION",
      "OUTCOME",
      "ADJ",
      "PROBLEM",
      "DIRECTION",
      "QUESTION",
      "BODY_PART",
      "DURATION",
      "MEDICINE",
      "COLOR",
      "WEATHER",
      "PLAN_OUTCOME",
      "EXAM_PROBLEM",
      "EXAM_OUTCOME",
      "INTRO_QUESTION",
      "FAMILY_MEMBER",
      "MEETING_REACTION",
      "TREATMENT",
      "HOSPITAL_OUTCOME",
      "TECH_PROBLEM",
      "DEVICE",
      "PARTY_PREP",
      "PARTY_CELEBRATION",
      "BIRTHDAY_OUTCOME"
    ],
    "_tag_sharing_note": "OUTCOME is shared across restaurant/taxi/hotel/shopping because they're all the same register -- a service worker resolving a complaint ('apologizes and fixes it' fits a shop clerk exactly as well as a waiter). weather_plans and exam_trouble are a different register (a friend making plans; a student's own feelings about an exam), so they get PLAN_OUTCOME / EXAM_OUTCOME instead of forcing 'the teacher argues with you' into a pool it doesn't belong in. Rule of thumb: share a tag across scenarios only when swapping either scenario's real lexicon entries into the other would still make sense -- if not, that's the signal to split.",
    "lesson_pos_tags": [
      "NOUN",
      "VERB",
      "ADJECTIVE",
      "ADVERB",
      "PHRASE"
    ],
    "lesson_pos_tags_not_used_for_generation": {
      "_comment": "These get tagged too (useful for other parts of the app -- grammar drills, flashcards) but are deliberately left out of the suggested-words panel and never swap into scenario text. A lone measure word, particle, or pronoun isn't something a beginner can 'use in a sentence' the way a noun or verb is, and it doesn't add anything to say 'suggested word: 我' when the learner was going to use 'I' regardless.",
      "PRONOUN": "he/she/this/that/who/etc. -- always needed, not meaningfully 'suggested'",
      "QUESTION": "who/what/where/how -- same reasoning as PRONOUN",
      "MEASURE": "classifier words (个/件/本) -- meaningless without a noun attached",
      "NUMBER": "numerals -- not tied to any scenario content",
      "PARTICLE": "grammatical particles (了/吗/的) -- no standalone lexical content"
    },
    "article_tags": [
      "THING_FOOD",
      "THING_PERSONAL",
      "PLACE",
      "PLACE_DESTINATION",
      "LANDMARK",
      "ADJ",
      "MEDICINE",
      "DEVICE"
    ],
    "_article_note": "A word's 'article' field can be an empty string to mean 'no article at all' -- needed for uncountable nouns (money) and plural-only nouns (pants) where 'a money'/'a pants' would be wrong. The code must render an empty article as no article and no extra space, not ' money'.",
    "integration_map": {
      "_comment": "How a lesson word's tag maps to eligible narrative slots. NOUN is gated by an explicit 'subtype' field on the word (food / personal / place) rather than being eligible everywhere -- a generic noun like 'weather' or 'name' has no subtype and is simply never swapped into scenario text (still fine as a suggested word). VERB and ADJECTIVE are left ungated: a random verb/adjective from a beginner list ('to sing', 'busy') might read as slightly odd in context but is never broken or semantically confused the way a wrong-category noun was. ADVERB and PHRASE map to nothing -- they're suggestion-only, since 'however' or 'thank you' can't grammatically fill a slot.",
      "NOUN": {
        "food": [
          "THING_FOOD"
        ],
        "personal": [
          "THING_PERSONAL"
        ],
        "place": [
          "PLACE",
          "PLACE_DESTINATION",
          "LANDMARK"
        ],
        "body_part": [
          "BODY_PART"
        ],
        "medicine": [
          "MEDICINE"
        ],
        "family": [
          "FAMILY_MEMBER"
        ],
        "device": [
          "DEVICE"
        ]
      },
      "VERB": [
        "ACTION"
      ],
      "ADJECTIVE": [
        "ADJ"
      ],
      "ADVERB": [],
      "PHRASE": []
    },
    "response_cues": {
      "state_goal": "Say what you want, or what you're looking for.",
      "make_request": "Ask {person} for what you need.",
      "point_out_problem": "Point out what's wrong.",
      "respond_to_excuse": "Respond to what {person} just told you.",
      "answer_question": "Answer {person}'s question.",
      "describe": "Describe it in your own words.",
      "react_to_outcome": "Say how you feel about how it turned out.",
      "respond_to_advice": "Respond to {person}'s advice.",
      "introduce_self": "Introduce yourself.",
      "say_goodbye": "Say goodbye and wrap things up.",
      "confirm_understanding": "Repeat back what you understood, to confirm.",
      "state_plan": "Say what you plan to do.",
      "greet": "Greet {person}.",
      "present_gift": "Give {person} the gift and say something nice."
    },
    "_response_cues_note": "Every round gets a 'response_type' key pointing into response_cues, resolved (interpolating {person}, same as templates) and shown alongside the scenario text so the learner always knows what kind of thing to say -- not just what's happening. Reused across scenarios rather than hand-written per round so adding a new scenario just means picking from this list."
  },
  "lexicon_example": {
